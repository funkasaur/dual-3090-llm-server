    {
      "datasource": {
        "type": "prometheus",
        "uid": "efnh5gcimbv28f"
      },
      "description": "FIXED twice. Volts and amps are both reported x10, so the original current x voltage expression was out by 100 - it showed ~30 kVA instead of ~300 VA. The relabelling must also be applied to the product rather than one operand, or the two vectors carry different labels and the multiplication matches nothing.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "decimals": 0,
          "unit": "voltamp"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "efnh5gcimbv28f"
          },
          "expr": "label_replace(label_replace((upsAdvanceOutputCurrent * upsAdvanceOutputVoltage) / 100, \"ups\",\"AI Server\",\"instance\",\"10.0.0.114\"), \"ups\",\"Desktop\",\"instance\",\"10.0.0.62\")",
          "instant": false,
          "legendFormat": "{{ups}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Apparent Power",
      "type": "timeseries"
    },
