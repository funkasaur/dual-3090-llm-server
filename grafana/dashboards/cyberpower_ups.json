{
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "efnh5gcimbv28f"
      },
      "description": "upsBaseOutputStatus. 2 = Online (running from mains). Anything else means the UPS is not cleanly passing mains through.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [
            {
              "options": {
                "1": {
                  "color": "text",
                  "text": "Unknown"
                },
                "2": {
                  "color": "green",
                  "text": "Online"
                },
                "3": {
                  "color": "red",
                  "text": "ON BATTERY"
                },
                "4": {
                  "color": "yellow",
                  "text": "On Smart Boost"
                },
                "5": {
                  "color": "yellow",
                  "text": "Timed Sleep"
                },
                "6": {
                  "color": "yellow",
                  "text": "Software Bypass"
                },
                "7": {
                  "color": "red",
                  "text": "OFF"
                },
                "8": {
                  "color": "yellow",
                  "text": "Rebooting"
                }
              },
              "type": "value"
            }
          ],
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "efnh5gcimbv28f"
          },
          "expr": "label_replace(label_replace(upsBaseOutputStatus, \"ups\",\"AI Server\",\"instance\",\"10.0.0.114\"), \"ups\",\"Desktop\",\"instance\",\"10.0.0.62\")",
          "instant": false,
          "legendFormat": "{{ups}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Output Status",
      "type": "stat"
    },
