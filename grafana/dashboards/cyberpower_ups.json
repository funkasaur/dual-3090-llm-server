      },
      "description": "FIXED: the raw OID is TimeTicks (hundredths of a second), so 300000 means 3000 s = 50 min. The panel previously fed the raw value into a 'minutes' unit, displaying ~30 weeks. Divided by 6000 to get minutes.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "green",
                "value": 20
              }
            ]
          },
          "unit": "m"
        },
        "overrides": []
