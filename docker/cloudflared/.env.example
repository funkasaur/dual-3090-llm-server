# Copy to .env. NEVER commit the real .env.
#
# This token is a bearer credential for the tunnel: anyone holding it can run
# your tunnel. Get it from the Cloudflare Zero Trust dashboard under
# Networks > Tunnels > your tunnel > Install and configure.
#
# If it ever leaks, rotate the tunnel token in the dashboard immediately.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME
