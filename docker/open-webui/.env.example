# Copy to .env and fill in. NEVER commit the real .env.
#
# Generate strong values, e.g.:
#   openssl rand -hex 32

POSTGRES_USER=webui_admin
POSTGRES_PASSWORD=CHANGE_ME_long_random_string
POSTGRES_DB=open_webui_db

# Signs Open WebUI session cookies. Changing it logs everyone out.
WEBUI_SECRET_KEY=CHANGE_ME_long_random_string

# Infinity does not enforce auth by default, but Open WebUI requires a
# non-empty value for these OpenAI-compatible clients. Any random string works.
RAG_OPENAI_API_KEY=CHANGE_ME_any_random_string
RAG_EXTERNAL_RERANKER_API_KEY=CHANGE_ME_any_random_string
