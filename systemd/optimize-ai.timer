# Optional but recommended.
#
# IRQ affinity is not sticky: reloading the NVIDIA module, or anything that
# re-enumerates the devices, drops the pinning back to the default all-CPU
# mask with no log entry and no failed unit. Re-asserting it hourly turns a
# silent regression into a self-healing one. The script is idempotent.

[Unit]
Description=Re-assert GPU IRQ pinning hourly

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h
Persistent=true

[Install]
WantedBy=timers.target
