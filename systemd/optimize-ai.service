# Pins GPU interrupts away from the inference cores.
#
# Ordering note: the original unit used only `After=network.target`, which says
# nothing about the NVIDIA driver. On a cold boot the unit ran before the driver
# had registered its interrupts, the script found none and exited 1, and the
# pinning silently never happened. The script now waits for the driver itself,
# and the ordering below makes that wait short.

[Unit]
Description=AI Hardware IRQ Optimizer (GPU interrupt pinning)
Wants=nvidia-persistenced.service
After=nvidia-persistenced.service systemd-modules-load.service local-fs.target

# No ConditionPathExistsGlob=/dev/nvidia[0-9]*: on the 2026-10-07 boot the
# check ran at 11:13:10 and /dev/nvidia0 appeared at 11:13:11, so the unit was
# skipped and boot-time IRQ pinning waited for the hourly timer. The script waits for
# the driver itself.

[Service]
Type=oneshot
# MUST be no. With RemainAfterExit=yes the unit stays "active" after its first
# run, and systemd treats every later `start` as a no-op — so optimize-ai.timer
# would fire hourly and do nothing at all. Verified: 3 starts produced 1 run
# with yes, and 3 runs with no. IRQ affinity is runtime state that has to be
# re-asserted, so the unit must actually re-execute.
RemainAfterExit=no
ExecStart=/usr/local/bin/optimize-ai.sh

[Install]
WantedBy=multi-user.target
